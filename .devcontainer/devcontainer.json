{
  "build": { "dockerfile": "Dockerfile" },
  "features": {
	"ghcr.io/devcontainers/features/common-utils:2": {
		"installZsh": true,
		"installOhMyZsh": true,
		"upgradePackages": true
	}
  },
	"customizations": {
		"vscode": {
			"extensions": [
				"usernamehw.errorlens",
				"StoilDobreff.php-resolver",
				"felixfbecker.php-debug",
				"neilbrayfield.php-docblocker",
				"streetsidesoftware.code-spell-checker",
				"TabNine.tabnine-vscode",
				"sleistner.vscode-fileutils",
				"bmewburn.vscode-intelephense-client",
				"sdras.night-owl",
				"waderyan.gitblame",
				"felixfbecker.php-pack",
				"xdebug.php-debug",
				"zaaack.markdown-editor",
				"RobertOstermann.inline-parameters-extended",
				"mrmlnc.vscode-duplicate"
			]
		}
	},

	// For use with PHP or Apache (e.g.php -S localhost:8080 or apache2ctl start)
	"forwardPorts": [
		80,
		81,
		3306,
		8025,
		1025,
		9000
	],

	"portsAttributes": {
		"3306": {
			"label": "Database (internal)"
		},
		"80": {
			"label": "WordPress"
		},
		"81": {
			"label": "WordPress Multi"
		},
		"8025": {
			"label": "Mail Hog Client"
		}
	},

	"postCreateCommand": "./.devcontainer/postCreateCommand.sh > .devcontainer/postCreateCommand.log",

	"postStartCommand": "./.devcontainer/postStartCommand.sh"
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}